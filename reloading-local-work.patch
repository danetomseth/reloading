+export const fromMil = (mil: number, u: AngleUnit) => (u === 'mil' ? mil : mil * MOA_PER_MIL);
+export const clickMil = (u: AngleUnit) => (u === 'mil' ? 0.1 : 0.25 / MOA_PER_MIL);
